{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "google-4-tbsync@marcozanon.com",
      "strict_min_version": "140.0",
      "strict_max_version": "151.*"
    }
  },
  "name": "__MSG_extensionName__",
  "version": "1.0.4",
  "author": "Marco Zanon",
  "homepage_url": "https://github.com/jobisoft/google-4-tbsync",
  "default_locale": "en-US",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png"
  },
  "permissions": [
    "storage",
    "identity",
    "management",
    "addressBooks",
    "notifications",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://people.googleapis.com/*"
  ],
  "background": {
    "type": "module",
    "scripts": ["background.mjs"]
  },
  "experiment_apis": {
    "LegacyAbProperties": {
      "schema": "experiments/LegacyAbProperties/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["LegacyAbProperties"]],
        "script": "experiments/LegacyAbProperties/implementation.js"
      }
    }
  },
  "web_accessible_resources": [
    "icons/icon-16.png",
    "icons/icon-32.png",
    "icons/icon-64.png"
  ]
}
